{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DetailedErrors": true,
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  },
  "InfluxDB": {
    "Url": "http://localhost:8181",
    "Token": "",
    "RetentionDays": 30,
    "DefaultDatabase": "lionk"
  }
}
